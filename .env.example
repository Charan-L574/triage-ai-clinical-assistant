# ── Required API Keys ─────────────────────────────────────────────────────────
# Get from https://huggingface.co/settings/tokens
# You MUST accept MedGemma terms at https://huggingface.co/google/medgemma-27b-text-it
HF_TOKEN=

# Get from https://console.groq.com/keys
GROQ_API_KEY=

# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Optional Model Overrides ─────────────────────────────────────────────────
# MEDGEMMA_MODEL_ID=google/medgemma-27b-text-it
# GROQ_MODEL_ID=llama-3.3-70b-versatile
# GEMINI_MODEL_ID=gemini-2.5-flash
# EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2

# ── Storage ───────────────────────────────────────────────────────────────────
# DB_PATH=./triageai.db
# FAISS_INDEX_PATH=./rag/disease_index/

# ── Tuning ────────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
# CONFIDENCE_THRESHOLD_LOW=0.55
# CONFIDENCE_THRESHOLD_CRITICAL=0.40
# API_TIMEOUT_SECONDS=45
# MAX_LLM_RETRIES=1
# RAG_TOP_K=5

# ── Streamlit ─────────────────────────────────────────────────────────────────
# STREAMLIT_API_BASE_URL=http://localhost:8000
